SENSOR_CACHE_MINUTES=30
SENSOR_FRESHNESS_HOURS=3
SYNC_INTERVAL_MINUTES=30
INITIAL_HISTORY_DAYS=92
WEATHER_HISTORY_DAYS=92
WEATHER_HISTORY_SYNC_HOURS=24
ENABLE_BACKGROUND_SYNC=true

